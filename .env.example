# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=shop_admin_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Ozon (закомментировано — интеграция с Ozon Seller API отключена)
# OZON_SHOP_ID=your_ozon_shop_id_here

# Yandex Object Storage (фото книг)
# PHOTO_S3_ENABLED=False — фото лежат локально в media/, как раньше.
# Для включения задайте True и заполните статические ключи сервисного аккаунта.
PHOTO_S3_ENABLED=False
YC_S3_BUCKET=gory-knig
YC_S3_ACCESS_KEY=your_access_key_here
YC_S3_SECRET_KEY=your_secret_key_here
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_REGION=ru-central1
# YC_S3_PUBLIC_BASE_URL=https://storage.yandexcloud.net/gory-knig
# YC_S3_TIMEOUT=15
# YC_S3_MAX_ATTEMPTS=3
